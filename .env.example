APP_NAME="Kelautan.ID X-Media Extractor"
APP_URL="https://xmedia.kelautan.id"
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kelautan_xmedia
DB_USER=kelautan_user
DB_PASS=secret_password

# Pengaturan Penyimpanan & Keamanan
MAX_FILE_SIZE_MB=250
MAX_STORAGE_GB=10
PUBLIC_ARCHIVE_GALLERY=true
CACHE_TTL_SECONDS=3600

# Fallback Opsional
YTDLP_ENABLED=false
YTDLP_PATH=/usr/local/bin/yt-dlp
